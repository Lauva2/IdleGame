/[Mm]emoryCaptures/
/[Rr]ecordings/
/.gradle/

# Build output
/[Bb]uild/
/[Bb]uilds/
*.apk
*.aab
*.unitypackage

# Generated IDE files
/.vs/
/.idea/
/.vscode/
*.csproj
*.sln
*.slnx
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.opendb
*.VC.db
*.csproj.meta
*.pidb.meta

# Crash dumps and OS files
/sysinfo.txt
*.stackdump
*.dmp
.DS_Store
Thumbs.db
Desktop.ini
/ArtSource/*.blend[0-9]

# Local credentials, signing files and machine-specific configuration
.env
.env.*
!.env.example
*.keystore
*.jks
*.pfx
*.p12
/.codex/
/.agents/
/.aws/

# Downloaded local tool installers and generated test scratch data
/Tools/Downloads/
/Tools/TestOutput/
/Tools/UnityAndroid/
/Tools/SevenZip/
/Tools/AndroidModule/
/Tools/AndroidBuildProject/
/Tools/PythonModules/
/Tools/AndroidSdk/
/Tools/Scrcpy/

